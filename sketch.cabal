cabal-version: 3.0
name:          sketch
version:       0.2.0.0
synopsis:      Handwritten notes on an endless canvas
license:       BSD-3-Clause
license-file:  LICENSE
maintainer:    pfoch.tomke@gmail.com
category:      Graphics
build-type:    Simple
extra-source-files: README.md templates/*.svg templates/make.sh

common shared
  default-language:   GHC2021
  default-extensions: BlockArguments LambdaCase OverloadedRecordDot
  ghc-options:        -Wall -O2 -fspecialise-aggressively -fexpose-all-unfoldings
  build-depends:      base ^>=4.22, containers, linear

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules: Canvas Model Render Stroke Svg Window
  build-depends:   bytestring, megaparsec, OpenGL, OpenGLRaw, sdl3-bindgen-sys, split, tagsoup

executable sketch
  import:         shared
  hs-source-dirs: app
  main-is:        Main.hs
  build-depends:  sketch, bytestring, directory, filepath, optparse-applicative, split
  ghc-options:    -threaded

test-suite spec
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Spec.hs
  build-depends:  sketch, bytestring, OpenGL, vector, tasty, tasty-quickcheck, tasty-hunit


